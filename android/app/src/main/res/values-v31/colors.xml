<?xml version="1.0" encoding="utf-8"?>
<!-- Material You: the widget takes its palette from the wallpaper (Android 12+). Tone pairs are
     at least 50 tones apart (95 vs 10/30/40), which keeps every text pair above 4.5:1. -->
<resources>
    <!-- Surface: the dynamic neutral the Google search bar sits on (tone 95), so the card reads as its sibling. -->
    <color name="widget_surface">@android:color/system_neutral1_50</color>
    <color name="widget_surface_variant">@android:color/system_accent2_100</color>
    <color name="widget_text">@android:color/system_neutral1_900</color>
    <color name="widget_text_muted">@android:color/system_neutral2_700</color>
    <color name="widget_accent">@android:color/system_accent1_600</color>
    <!-- Tonal controls: secondary tone 40 with tone 100 glyphs (pill 3:1+ on the tone 95 card, glyph 3:1+ on the pill).
         Material 3 secondary-container (tone 90) is only about 1.1:1 against this card, so it is not used. -->
    <color name="widget_control">@android:color/system_accent2_600</color>
    <color name="widget_on_control">@android:color/system_accent2_0</color>
    <!-- Glass tint: the launcher re-inflates this on a wallpaper or theme change (tone 10, near-black). -->
    <color name="widget_glass_tint">@android:color/system_neutral1_900</color>
</resources>
