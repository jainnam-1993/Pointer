<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark surface: dynamic neutral tone 20, like the Google search bar in dark mode (tone 10 read as a black hole). -->
    <color name="widget_surface">@android:color/system_neutral1_800</color>
    <color name="widget_surface_variant">@android:color/system_neutral2_800</color>
    <color name="widget_text">@android:color/system_neutral1_50</color>
    <color name="widget_text_muted">@android:color/system_neutral2_200</color>
    <color name="widget_accent">@android:color/system_accent1_200</color>
    <!-- Dark: secondary tone 70 with tone 20 glyphs, on the tone 10 card. -->
    <color name="widget_control">@android:color/system_accent2_300</color>
    <color name="widget_on_control">@android:color/system_accent2_800</color>
</resources>
