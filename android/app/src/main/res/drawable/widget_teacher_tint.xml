<?xml version="1.0" encoding="utf-8"?>
<!-- Soft, borderless tint behind the left-aligned teacher line on the dark glass: densest at the
     start of the line and fading to nothing toward the controls, so there is no box edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:type="linear" android:angle="0"
        android:startColor="#A61C1B1F" android:centerColor="#731C1B1F" android:endColor="#001C1B1F" />
</shape>
