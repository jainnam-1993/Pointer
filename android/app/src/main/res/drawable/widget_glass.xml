<?xml version="1.0" encoding="utf-8"?>
<!-- The dark glass (the user's pick): the tint at the look's alpha, with a soft top sheen so it
     reads as glass rather than a flat smoke slab. The thin bright rim and the one-pixel top
     highlight are drawn crisp by widget_frost_overlay on top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_glass_tint" />
            <corners android:radius="@dimen/widget_corner_radius" />
        </shape>
    </item>
    <item android:bottom="64dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270" android:startColor="#2EFFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="@dimen/widget_corner_radius" android:topRightRadius="@dimen/widget_corner_radius" />
        </shape>
    </item>
</layer-list>
