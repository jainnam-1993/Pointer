<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted card. Layers, bottom to top: translucent Material You body (top to bottom), a soft
     sheen over the upper half, a gentle shade at the bottom (inner shadow), static grain, a fine
     rim, and a one-pixel highlight along the top edge. All at the launcher's corner radius; the
     root's clipToOutline keeps the grain inside the corners. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="@color/widget_frost_top"
                android:endColor="@color/widget_frost_bottom" />
            <corners android:radius="@dimen/widget_corner_radius" />
        </shape>
    </item>
    <item android:bottom="40dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="@color/widget_sheen"
                android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="@dimen/widget_corner_radius" android:topRightRadius="@dimen/widget_corner_radius" />
        </shape>
    </item>
    <item android:top="48dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="#00000000"
                android:endColor="@color/widget_shade" />
            <corners android:bottomLeftRadius="@dimen/widget_corner_radius" android:bottomRightRadius="@dimen/widget_corner_radius" />
        </shape>
    </item>
    <item>
        <bitmap android:src="@drawable/widget_grain" android:tileMode="repeat" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/widget_rim" />
            <corners android:radius="@dimen/widget_corner_radius" />
        </shape>
    </item>
    <item android:gravity="top|fill_horizontal" android:height="1dp"
        android:left="@dimen/widget_corner_radius" android:right="@dimen/widget_corner_radius">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_highlight" />
        </shape>
    </item>
</layer-list>
