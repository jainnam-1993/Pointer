<?xml version="1.0" encoding="utf-8"?>
<!-- Legibility scrim behind the text only (like iOS widgets and the lock screen): the card body
     stays see-through (GlassRule.FIXED_ALPHA) and this soft, rounded layer in the glass tone sits
     under the quote and the teacher line, densest in the middle and fading toward its edges. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#661C1B1F" />
            <corners android:radius="@dimen/widget_inner_radius" />
        </shape>
    </item>
    <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="#8C1C1B1F" android:centerColor="#991C1B1F" android:endColor="#8C1C1B1F" />
            <corners android:radius="@dimen/widget_inner_radius" />
        </shape>
    </item>
</layer-list>
