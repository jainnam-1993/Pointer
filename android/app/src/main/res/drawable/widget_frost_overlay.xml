<?xml version="1.0" encoding="utf-8"?>
<!-- Glass edge over the frosted card: a fine rim and a one-pixel highlight along the top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/widget_rim" />
            <corners android:radius="@dimen/widget_corner_radius" />
        </shape>
    </item>
    <item android:gravity="top|fill_horizontal" android:height="1dp"
        android:left="@dimen/widget_corner_radius" android:right="@dimen/widget_corner_radius">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_highlight" />
        </shape>
    </item>
</layer-list>
