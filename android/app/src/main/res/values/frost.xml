<?xml version="1.0" encoding="utf-8"?>
<!-- Frost opacities and light. RemoteViews cannot blur the wallpaper, so the widget imitates
     frosted glass: a translucent tinted body, a top highlight, a soft lower shade and static grain.
     Body opacities (color/, color-night/) are the floor that keeps 4.5:1 for the pointing text over any wallpaper. -->
<resources>
    <color name="widget_highlight">#B3FFFFFF</color>
    <color name="widget_rim">#40FFFFFF</color>
</resources>
