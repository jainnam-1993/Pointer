<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#FFFFFF</color>
    <color name="splash_background">#F7F4EE</color>
    <color name="widget_surface">#F7F5F2</color>
    <color name="widget_surface_variant">#ECE7F4</color>
    <color name="widget_text">#1C1C1E</color>
    <color name="widget_text_muted">#5A5560</color>
    <color name="widget_accent">#6D28D9</color>
    <color name="widget_control">#625B71</color>
    <color name="widget_on_control">#FFFFFF</color>
    <color name="widget_glass_tint">#FF1C1B1F</color>
    <!-- Text halo in the glass base tone: holds contrast over bright patches behind the glass. -->
    <color name="widget_text_halo">#B31C1B1F</color>
    <!-- App look (the widget as a piece of the app): sage-and-sand paper / ink-on-black, as in PointerColors. -->
    <!-- Light-mode opacity lives in this alpha (94 = 58%, cream at 58% until the user picks); the user picks the light value here. -->
    <color name="widget_app_card">#94F7F3EA</color>
    <color name="widget_app_card_end">#94F7F3EA</color>
    <color name="widget_app_card_solid">#FFF7F3EA</color>
    <color name="widget_app_ink">#FF1B1F1A</color>
    <color name="widget_app_ink_secondary">#FF2A2F29</color>
    <color name="widget_app_accent">#E61B1F1A</color>
    <color name="widget_app_pill">#66FFFFFF</color>
    <color name="widget_app_rim">#66FFFFFF</color>
    <!-- Ink hairline (18%) so the controls hold on a white wallpaper, where a white fill alone vanishes. -->
    <color name="widget_app_pill_stroke">#2E1B1F1A</color>
    <!-- Outer dark hairline under the white rim, so the card edge holds on a white wallpaper (light only). -->
    <color name="widget_app_rim_outer">#291B1F1A</color>
</resources>
