<?xml version="1.0" encoding="utf-8"?>
<!-- Large (4x4): tradition eyebrow, a generous serif pointing, the teacher, then the controls.
     Only RemoteViews-allowlisted classes (WidgetLayoutTest). Colors and radii come from
     values(-night)(-v31), so Android 12+ follows the wallpaper and older versions keep the house palette. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clipToOutline="true"
    android:padding="@dimen/widget_padding"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:id="@+id/widget_content_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_tradition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/widget_accent" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:textColor="@color/widget_text"
            android:autoSizeTextType="uniform"
            android:autoSizeStepGranularity="1sp"
            android:gravity="top|start"
            android:maxLines="12"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="24sp"
            android:lineSpacingMultiplier="1.25" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_teacher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="14sp"
        android:textColor="@color/widget_text_muted" />

    <LinearLayout
        android:id="@+id/widget_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical|end">

        <ImageView
            android:id="@+id/widget_save"
            android:layout_width="@dimen/widget_touch_target"
            android:layout_height="@dimen/widget_touch_target"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_heart_outline"
            android:tint="@color/widget_accent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_save" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/widget_touch_target"
            android:layout_marginStart="4dp"
            android:orientation="horizontal"
            android:background="@drawable/widget_control_pill">

            <ImageView
                android:id="@+id/widget_prev"
                android:layout_width="@dimen/widget_touch_target"
                android:layout_height="@dimen/widget_touch_target"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_left"
                android:tint="@color/widget_accent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/widget_previous" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="@dimen/widget_touch_target"
                android:layout_height="@dimen/widget_touch_target"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/widget_accent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/widget_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
