# Override global gitignore - Flutter needs lib/ tracked
!lib/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
test/golden/failures/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
worktrees/

# App signing (NEVER commit these)
android/key.properties
android/app/upload-keystore.jks
*.keystore
*.jks
android/play-store-credentials.json

# Test output (integration test screenshots, generated assets)
test_output/
maestro/screenshots/

# Root-level test screenshots & Unison conflict artifacts
/*conflict*.png
/*was_deleted*.png

# Build artifacts
.gradle/
android/app/local.properties
android/gradle/

# Claude Code local state
.claude/

# iOS generated files
ios/ExportOptions.plist
